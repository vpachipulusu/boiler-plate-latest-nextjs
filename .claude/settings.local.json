{
  "permissions": {
    "allow": [
      "Bash(test:*)",
      "Bash(ls:*)",
      "Bash(npm view:*)",
      "Bash(timeout:*)",
      "Bash(taskkill:*)",
      "Bash(if exist \".next\\\\dev\\\\lock\" del /F \".next\\\\dev\\\\lock\")",
      "Bash(curl:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx next:*)",
      "Bash(pkill:*)",
      "Bash(npm run test:unit:*)",
      "Bash(npm run test:integration:*)",
      "Bash(npm test:*)",
      "Bash(npm run dev:kill:*)",
      "Bash(git mv:*)",
      "Bash(git add:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx tsc:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(powershell:*)",
      "Bash(del \"c:\\\\MainData\\\\NewSourceCode\\\\boiler-plate-latest-nextjs\\\\add-path.ps1\")",
      "Bash(npm run typecheck:*)",
      "Bash(claude:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(dir:*)",
      "Bash(node scripts/test-logger-verify.mjs:*)",
      "Bash(cmd /c \"dir C:\\\\MainData\\\\NewSourceCode\\\\boiler-plate-latest-nextjs\\\\logs 2>&1\")",
      "Bash(node -e:*)",
      "Bash(done)"
    ]
  },
  "hooks": {
    "PrePlan": [
      {
        "matcher": ".*next\\.?(js|config|ts)?.*|.*app router.*|.*server component.*|.*route.*handler.*|metadata.*|.*rsc.*",
        "hooks": [
          {
            "type": "injectContext",
            "files": [".agents/skills/next-best-practices/SKILL.md"]
          }
        ]
      },
      {
        "matcher": ".*ui.*|.*component.*|.*design.*|.*page.*|.*layout.*|.*dashboard.*|.*frontend.*|.*style.*|.*tailwind.*",
        "hooks": [
          {
            "type": "injectContext",
            "files": [".agents/skills/frontend-design/SKILL.md"]
          }
        ]
      },
      {
        "matcher": ".*capacitor.*|.*mobile.*|.*ios.*|.*android.*|.*native.*",
        "hooks": [
          {
            "type": "injectContext",
            "files": [".agents/skills/capacitor-best-practices/SKILL.md"]
          }
        ]
      },
      {
        "matcher": ".*react native.*|.*expo.*|.*mobile.*",
        "hooks": [
          {
            "type": "injectContext",
            "files": [".agents/skills/vercel-react-native-skills/SKILL.md"]
          }
        ]
      },
      {
        "matcher": ".*browser.*|.*automat.*|.*screenshot.*|.*scrape.*|.*web test.*",
        "hooks": [
          {
            "type": "injectContext",
            "files": [".agents/skills/browser-use/SKILL.md"]
          }
        ]
      },
      {
        "matcher": ".*skill.*|.*find.*skill.*|.*install.*skill.*",
        "hooks": [
          {
            "type": "injectContext",
            "files": [".agents/skills/find-skills/SKILL.md"]
          }
        ]
      }
    ]
  }
}
